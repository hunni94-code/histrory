<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>일제 통치 시뮬레이터</title>
<style>
:root{--bg:#0c0907;--panel:#1d1713;--gold:#bc8d4d;--red:#9f3028;--ink:#f2e9da}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top,#2a1d16,#100c0a 50%,#080605);color:var(--ink);font-family:"Noto Sans KR","Malgun Gothic",sans-serif;min-height:100vh}
.wrap{width:min(1120px,95vw);margin:auto;padding:24px 0 42px}.hero{border:1px solid #6d5334;border-radius:22px;overflow:hidden;box-shadow:0 24px 60px #0009;background:#090706}
.hero img{width:100%;height:auto;display:block}
.copy{position:absolute;z-index:2;left:42px;bottom:35px;max-width:650px;text-shadow:0 3px 12px #000}.copy small{color:#e5b56f;font-weight:900;letter-spacing:.18em}
h1{font-family:Georgia,"Noto Serif KR",serif;font-size:clamp(40px,6vw,72px);margin:8px 0}.copy p{font-size:18px;line-height:1.65;margin:0;color:#efe4d4}
.notice{margin:16px 0;background:#251b16;border:1px solid #5c422d;border-radius:14px;padding:14px 17px;color:#d8c9b7;line-height:1.55}
.hud{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;margin:17px 0}.track{height:12px;background:#382a20;border:1px solid #5d432d;border-radius:999px;overflow:hidden}#bar{height:100%;width:0;background:linear-gradient(90deg,#8c261f,#d5a04f);transition:.3s}
.pill{background:#211913;border:1px solid #5e4632;border-radius:999px;padding:9px 14px;font-weight:900}.card{background:linear-gradient(#211914,#15100d);border:1px solid #6c4d31;border-radius:22px;padding:clamp(22px,4vw,38px);box-shadow:0 18px 40px #0008}
.meta{display:flex;gap:10px;flex-wrap:wrap}.meta span{padding:7px 12px;border:1px solid #6e4f34;border-radius:999px;background:#2a1f18;color:#deb77e;font-weight:900;font-size:14px}.goal{margin:16px 0;background:#301815;border-left:5px solid var(--red);padding:13px 15px;border-radius:8px}
.question{font-family:"Noto Serif KR",serif;font-size:clamp(24px,3.5vw,35px);line-height:1.45;margin:0 0 23px}.choices{display:grid;gap:13px}.choice{display:flex;gap:14px;width:100%;text-align:left;background:linear-gradient(#2b211a,#211913);color:var(--ink);border:1px solid #6e5036;border-radius:14px;padding:16px 17px;font-size:17px;line-height:1.55;cursor:pointer;transition:.16s}
.choice:hover{transform:translateY(-2px);border-color:#bb8d4c}.choice:disabled{cursor:default;transform:none}.n{width:34px;height:34px;flex:0 0 34px;display:grid;place-items:center;border:1px solid #806040;border-radius:8px;background:#17110e;color:#e2b571;font-weight:900}
.correct{background:#183023!important;border-color:#55936b!important}.wrong{background:#391816!important;border-color:#bd4d45!important}.feedback{display:none;margin-top:19px;padding:17px;border-radius:13px;line-height:1.65}.show{display:block}.good{background:#173024;border:1px solid #4f8b64}.bad{background:#351815;border:1px solid #a8463e}.feedback h3{margin:0 0 6px}
.actions{display:flex;justify-content:flex-end;margin-top:17px}button.next{border:1px solid #a47741;background:linear-gradient(#922f26,#681d18);color:white;border-radius:10px;padding:12px 18px;font-size:16px;font-weight:900;cursor:pointer}button.alt{background:#2a211a}
.result{text-align:center}.big{font-size:74px;color:#d6a04e;font-weight:900}.result ul{list-style:none;padding:0;max-width:720px;margin:20px auto;text-align:left}.result li{margin:8px 0;background:#271d17;border:1px solid #604631;border-radius:10px;padding:13px}.foot{text-align:center;color:#a29483;font-size:13px;margin-top:13px}
@media(max-width:700px){.copy{left:22px;right:22px}.hud{grid-template-columns:1fr 1fr}.track{grid-column:1/-1}.choice{font-size:15.5px}}
</style></head><body>
<div class="wrap">
<section class="hero"><img src="data:image/png;base64," alt="어두운 분위기의 조선총독 이미지"></section>
<div class="notice">⚠️ 이 게임은 일제의 식민 통치를 미화하기 위한 것이 아니라 폭력·수탈·민족 말살 정책의 변화와 문제점을 학습하기 위한 교육용 자료입니다.</div>
<div class="hud"><div class="track"><div id="bar"></div></div><div id="score" class="pill">점수 0점</div><div id="count" class="pill">1 / 4</div></div>
<main id="card" class="card"></main><div class="foot">첫 시도 정답 25점 · 재도전 정답 15점 · 오답 유형은 결과에서 확인</div></div>
<script>
const qs=[{"year": "1910년", "goal": "저항을 억누르고 식민 지배를 시작하라", "q": "일본은 대한제국을 강제로 병합하였다. 조선을 안정적으로 지배하기 위해 가장 효과적인 통치 방법은 무엇일까?", "c": ["군대와 헌병 경찰을 이용해 강압적으로 통치하고 자원을 수탈한다.", "일부 조선인에게 혜택을 주어 서로 단결하지 못하도록 만든다.", "조선인의 민족 정체성을 없애 일본인이라고 생각하게 만든다."], "a": 0, "concept": "무단 통치", "exp": "병합 직후 일제는 헌병 경찰과 군대를 앞세워 조선인의 저항을 억압하고 토지와 자원을 수탈하였다.", "fb": ["식민 지배 초기에는 군대와 헌병 경찰을 앞세운 무단 통치가 핵심이었다.", "조선인을 회유하고 분열시키는 방식은 3·1운동 이후 더욱 두드러졌다.", "민족 정체성을 없애려는 정책은 1930년대 후반 이후 본격화되었다."], "mis": ["", "무단 통치와 민족 분열 통치의 시기를 혼동함", "무단 통치와 민족 말살 통치의 시기를 혼동함"]}, {"year": "1919년", "goal": "3·1운동 이후 독립운동의 힘을 약화하라", "q": "3·1운동이 전국으로 확산되었다. 강압적인 통치만으로는 조선을 지배하기 어렵다는 사실이 드러났다. 가장 적절한 대응은 무엇일까?", "c": ["이전처럼 군대와 헌병 경찰만으로 강압적으로 통치한다.", "겉으로는 자유를 주는 것처럼 보이면서 조선인들이 서로 단결하지 못하도록 만든다.", "조선인의 민족 정체성을 없애고 일본인이라는 의식을 심는다."], "a": 1, "concept": "민족 분열 통치", "exp": "3·1운동 이후 일제는 통치를 완화하는 것처럼 보이게 하면서 친일 세력을 육성하고 조선인을 분열시켰다.", "fb": ["무력 탄압은 계속되었지만 새 통치 방식의 핵심은 아니었다.", "겉으로 완화된 모습을 보이면서 실제로는 친일 세력을 육성하고 민족을 분열시켰다.", "민족 정체성을 없애려는 정책은 1930년대 후반 이후와 관련이 깊다."], "mis": ["3·1운동 이후에도 무단 통치만 계속되었다고 이해함", "", "민족 분열 통치와 민족 말살 통치를 혼동함"]}, {"year": "1931~1937년", "goal": "전쟁에 필요한 물자와 생산 기반을 확보하라", "q": "대공황 이후 만주사변과 중일전쟁이 이어졌다. 일본은 더 많은 무기·식량·자원이 필요해졌다. 조선을 어떻게 활용하는 것이 가장 효과적일까?", "c": ["조선인들이 서로 단결하지 못하도록 계속 분열시킨다.", "공장을 늘리고 식량과 자원을 수탈하여 조선을 전쟁을 위한 병참기지로 만든다.", "조선인의 민족 정체성을 없애 일본인이라는 의식을 심는다."], "a": 1, "concept": "병참기지화 정책", "exp": "전쟁이 확대되자 일제는 군수 공업을 육성하고 식량과 자원을 수탈하여 조선을 대륙 침략의 병참기지로 만들었다.", "fb": ["민족 분열 정책은 계속되었지만 이 시기의 핵심 변화는 전쟁 수행을 위한 생산과 수탈의 확대였다.", "군수 공업을 확대하고 식량과 자원을 수탈하여 조선을 병참기지로 만들었다.", "민족 정체성을 없애는 정책도 뒤이어 강화되지만 이 문제의 핵심은 물자와 생산 기반 확보이다."], "mis": ["민족 분열 통치와 병참기지화 정책을 혼동함", "", "병참기지화 정책과 민족 말살 통치를 혼동함"]}, {"year": "1938~1945년", "goal": "조선인을 일본의 전쟁에 적극 동원하라", "q": "전쟁이 길어지면서 일본은 병사와 노동력이 크게 부족해졌다. 조선인을 더 적극적으로 전쟁에 동원하기 위한 통치 방식은 무엇일까?", "c": ["공장을 늘리고 식량과 자원을 더 많이 수탈한다.", "친일파를 이용해 일부 조선인만 설득하여 전쟁에 참여시킨다.", "조선인의 민족 정체성을 없애고 일본인이라는 의식을 심어 전쟁에 동원한다."], "a": 2, "concept": "민족 말살 통치", "exp": "일제는 일본어 사용 강요, 창씨개명, 신사 참배, 황국 신민 서사 등을 통해 조선인의 민족 정체성을 없애고 전쟁에 동원하려 하였다.", "fb": ["물자 수탈은 병참기지화 정책의 핵심이다. 지금은 인력까지 장기간 동원하기 위한 방식이 필요하다.", "친일 세력을 이용한 회유도 있었지만 일부만 설득하는 방식으로는 전체 조선인을 지속적으로 동원하기 어려웠다.", "조선인의 민족 정체성을 없애고 일본인으로 동화시켜 전쟁 동원을 정당화하려 했다."], "mis": ["병참기지화 정책과 민족 말살 통치를 혼동함", "민족 분열 통치와 민족 말살 통치를 혼동함", ""]}];let idx=0,score=0,tryNo=1,locked=false;const mis=[];
const card=document.getElementById('card'),bar=document.getElementById('bar'),scoreEl=document.getElementById('score'),count=document.getElementById('count');
function draw(){locked=false;tryNo=1;const q=qs[idx];bar.style.width=`${idx/qs.length*100}%`;count.textContent=`${idx+1} / ${qs.length}`;card.innerHTML=`<div class="meta"><span>${q.year}</span></div><div class="goal"><b>이번 목표:</b> ${q.goal}</div><h2 class="question">${q.q}</h2><div class="choices">${q.c.map((x,i)=>`<button class="choice" data-i="${i}"><span class="n">${i+1}</span><span>${x}</span></button>`).join('')}</div><div id="fb" class="feedback"></div><div id="act" class="actions"></div>`;document.querySelectorAll('.choice').forEach(b=>b.onclick=()=>pick(+b.dataset.i))}
function pick(i){if(locked)return;const q=qs[idx],bs=[...document.querySelectorAll('.choice')],fb=document.getElementById('fb'),act=document.getElementById('act');bs.forEach(b=>b.disabled=true);if(i===q.a){locked=true;bs[i].classList.add('correct');const gain=tryNo===1?25:15;score+=gain;scoreEl.textContent=`점수 ${score}점`;fb.className='feedback show good';fb.innerHTML=`<h3>정답 · ${q.concept}</h3><div>${q.fb[i]}</div><div style="margin-top:8px;color:#d8c6b1">${q.exp}</div>`;bar.style.width=`${(idx+1)/qs.length*100}%`;act.innerHTML=`<button class="next" onclick="go()">${idx===qs.length-1?'결과 보기':'다음 라운드'}</button>`}else{bs[i].classList.add('wrong');if(q.mis[i]&&!mis.includes(q.mis[i]))mis.push(q.mis[i]);fb.className='feedback show bad';fb.innerHTML=`<h3>다시 생각해 보자</h3><div>${q.fb[i]}</div><div style="margin-top:8px"><b>힌트:</b> 이 시기 일본의 가장 큰 목표가 무엇이었는지 생각해 보세요.</div>`;act.innerHTML=`<button class="next alt" onclick="retry()">피드백 확인 후 재도전</button>`}}
function retry(){tryNo=2;document.querySelectorAll('.choice').forEach(b=>{b.disabled=false;b.classList.remove('wrong','correct')});document.getElementById('fb').className='feedback';document.getElementById('act').innerHTML=''}
function go(){idx++;idx<qs.length?draw():result()}
function result(){const level=score>=90?'역사 추론가':score>=65?'개념 연결자':score>=40?'재도전 학습자':'기초 개념 점검 필요';const list=mis.length?mis.map(x=>`<li>⚠️ ${x}</li>`).join(''):'<li>✅ 주요 통치 방식의 시대적 차이를 정확히 구분했습니다.</li>';card.innerHTML=`<div class="result"><div class="meta" style="justify-content:center"><span>최종 결과</span></div><div class="big">${score}점</div><h2>${level}</h2><p>무단 통치 → 민족 분열 통치 → 병참기지화 → 민족 말살 통치</p><ul>${list}</ul><button class="next" onclick="restart()">처음부터 다시 하기</button></div>`}
function restart(){idx=0;score=0;mis.length=0;scoreEl.textContent='점수 0점';draw()}draw();
</script></body></html>
